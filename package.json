{
  "name": "daly-ventures-racing-intelligence",
  "version": "0.1.0",
  "description": "Evidence-governed horse-racing decision support and historical performance dashboard for Daly Ventures.",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brdaly/racing-intelligence.git"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "audit": "pnpm audit --audit-level high",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "test": "vitest run --config vitest.config.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.7",
    "@cloudflare/workers-types": "4.20260702.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "react-server-dom-webpack": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "^5.0.0",
    "vinext": "1.0.0-beta.3",
    "vite": "8.3.0",
    "wrangler": "4.131.0",
    "drizzle-kit": "0.31.10"
  },
  "type": "module"
}
